# =============================================================================
# Template configurazione PRODUZIONE (Melpis)
# =============================================================================
# Istruzioni:
#   1. Copia questo file come `.env.production` SOLO sul server di produzione.
#   2. Compila ogni placeholder con i valori reali presi dai gestori segreti.
#   3. NON committare mai `.env.production`: resta git-ignored.
#
# ATTENZIONE — DEMO_MODE: NON impostare DEMO_MODE in produzione. Con
# APP_ENV=production l'avvio viene BLOCCATO se DEMO_MODE è attivo
# (guardia in src/core/startup_guard.py), e qualunque valore va comunque
# rimosso dal file reale.


# --- Applicazione -------------------------------------------------------------
# Ambiente applicativo: `is_production()` legge APP_ENV o ENVIRONMENT
# (security/docs.py); usiamo APP_ENV per coerenza con .env.example.
APP_ENV=production
LAUNCH_PROFILE=commercial_bootstrap
SANDBOX_ONLY=false
WHATSAPP_TEST_RECIPIENTS=
INSTAGRAM_TEST_RECIPIENTS=
LLM_COST_POLICY=free_only
# Impostare true SOLO dopo verifica account FREE senza billing attivo.
GROQ_FREE_ACCOUNT_CONFIRMED=false
# Impostare true SOLO dopo avere abilitato e verificato Zero Data Retention in Groq.
GROQ_ZDR_CONFIRMED=false

# --- Deploy container e TLS --------------------------------------------------
# Copiare i riferimenti digest emessi nel GitHub Actions summary del commit
# approvato. Tag (anche SHA) e `latest` sono rifiutati dal release preflight.
MELPIS_API_IMAGE_REF=ghcr.io/<owner>/whatsapp-ai-responder-api@sha256:<64-lowercase-hex>
MELPIS_WEB_IMAGE_REF=ghcr.io/<owner>/whatsapp-ai-responder-web@sha256:<64-lowercase-hex>
# `temporary` carica esclusivamente Caddyfile.temporary e richiede PUBLIC_HOST.
# Passare a `final` solo dopo DNS/TLS verificati per melpis.it/app.melpis.it.
CADDY_SITE_MODE=temporary
PUBLIC_HOST=<temporary-tls-hostname>

# --- Identità legale pubblica ------------------------------------------------
# Copiare esclusivamente dati verificati dopo review legale. Questi valori
# corrispondono ai token in docs/superpowers/legal/legal-identity-tokens.md e
# sono bloccanti nel release preflight.
LEGAL_ENTITY_NAME=<ragione-sociale-verificata>
LEGAL_ENTITY_REGISTERED_OFFICE=<sede-legale-verificata>
LEGAL_ENTITY_VAT_NUMBER=<partita-iva-verificata>
LEGAL_PRIVACY_CONTACT_EMAIL=<contatto-privacy-verificato>
LEGAL_FORUM=<foro-competente-verificato>
LEGAL_DOCUMENT_EFFECTIVE_DATE=<data-effettiva-documenti-legali>
# Explicit legal decisions: all values are release blockers until a qualified
# reviewer approves the final public text. Do not infer or fabricate them.
LEGAL_PUBLIC_DOCUMENTS_REVIEWED=false
LEGAL_PRIVACY_REVIEW_APPROVED=false
LEGAL_TERMS_REVIEW_APPROVED=false
LEGAL_DPA_REVIEW_APPROVED=false
LEGAL_PAYMENT_SUSPENSION_DAYS=<giorni-sospensione-approvati>
LEGAL_ACCOUNT_TERMINATION_DAYS=<giorni-disattivazione-approvati>


# --- LLM / provider FREE ------------------------------------------------------
# La presenza della chiave non prova il tier: verificare il pannello account.
# Qualunque passaggio a un provider o piano AI a pagamento richiede una nuova
# autorizzazione manuale esplicita; nessun upgrade o fallback e' automatico.
LLM_MAX_CONCURRENT=3
# Default Groq. Alternativa zero-euro: AI_PROVIDER=openrouter e
# AI_MODEL=openrouter/<vendor>/<model>:free, con OPENROUTER_API_KEY dell'account
# free e disponibilita' ZDR verificata nel catalogo e con uno smoke test.
# In quel caso svuotare tutte le variabili OPENROUTER_MODEL* legacy sotto:
# il preflight le controlla anche se AI_MODEL definito.
AI_PROVIDER=groq
AI_MODEL=
AI_MODEL_CHEAP=
AI_MODEL_PREMIUM=
AI_MODEL_INTENT=
AI_MODEL_FALLBACKS=
OPENROUTER_API_KEY=
# Nomi storici delle variabili di routing; con Groq i valori restano Groq.
OPENROUTER_MODEL_CHEAP=groq/llama-3.1-8b-instant
OPENROUTER_MODEL_PREMIUM=groq/openai/gpt-oss-20b
OPENROUTER_MODEL_FALLBACKS=groq/llama-3.1-8b-instant,groq/openai/gpt-oss-120b
# Default quando il chiamante non seleziona una route.
OPENROUTER_MODEL=groq/openai/gpt-oss-20b
# Sotto questa soglia di budget residuo (0..1) il routing forza il tier economico.
LLM_LOW_BUDGET_RATIO=0.10


# Chiave dell'organizzazione FREE verificata.
GROQ_API_KEY=


# --- Guardrails (task 12, src/core/guardrails/) -------------------------------
# - classificatore di intent: modello economico (default = OPENROUTER_MODEL_CHEAP),
#   LLM usato solo quando l'euristica keyword e' incerta; fail-open sull'euristica
OPENROUTER_MODEL_INTENT=
GUARDRAIL_INTENT_LLM_ENABLED=true
# timeout (secondi) oltre il quale il classificatore LLM lascia il posto all'euristica
GUARDRAIL_INTENT_TIMEOUT=2.5
# - validatore post-LLM: lunghezza massima risposta inviata al cliente (caratteri)
GUARDRAIL_MAX_REPLY_CHARS=800
# - cache FAQ semantica: interruttore, distanza cosine massima per il match,
#   scadenza delle voci in ore (invalidata anche a ogni upload documento)
GUARDRAIL_CACHE_ENABLED=true
GUARDRAIL_CACHE_THRESHOLD=0.08
GUARDRAIL_CACHE_TTL_HOURS=72
# - A/B test prompt: varianti attive separate da virgola (definite in
#   src/agents/prompts.py PROMPT_VARIANTS; assegnazione deterministica per org)
GUARDRAIL_AB_VARIANTS=control


# --- Crittografia -------------------------------------------------------------
# Chiave Fernet per cifratura dati sensibili a riposo. Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<fernet-key-generata-con-il-comando-sopra>


# --- WhatsApp Cloud API (Meta) ------------------------------------------------
# Senza queste due il webhook /webhooks/whatsapp non viene montato all'avvio
# (l'app parte comunque, ma Meta non puo' raggiungerti). Valori dal dashboard
# Meta for Developers (App Settings -> Basic / Webhooks).
META_APP_SECRET=
META_VERIFY_TOKEN=<token-casuale-condiviso-col-dashboard-meta>


# --- Database -----------------------------------------------------------------
# Postgres di produzione: sslmode=require OBBLIGATORIO. Preferire un pooler
# esterno (Supavisor/pgBouncer) invece di gonfiare il pool per processo.
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# Dimensione massima del pool asyncpg (default 5): in produzione con piu'
# worker si usa 10; per picchi reali usare un pooler esterno.
DB_POOL_MAX_SIZE=3


# --- Supabase -----------------------------------------------------------------
# URL del progetto Supabase di produzione.
SUPABASE_URL=https://<project-ref>.supabase.co
# Chiave anon del progetto (pubblica, usata dal BFF verso /auth/v1/token).
SUPABASE_ANON_KEY=<anon-key-supabase>
# Service role key: SEGRETO server-side, mai esporla al client ne' loggarla.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-supabase>
# Audience attesa nei JWT Supabase durante la verifica (default "authenticated").
SUPABASE_JWT_AUD=authenticated
# Cookie di sessione con flag Secure + prefisso __Host-: SEMPRE true in produzione.
AUTH_COOKIE_SECURE=true


# --- URL pubblici / CORS ------------------------------------------------------
# URL pubblico dell'app (login Google OAuth PKCE: base del redirect_to verso
# /api/auth/google/callback). Guida: docs/SETUP-GOOGLE-AUTH.md
PUBLIC_APP_URL=https://melpis.it
# Origini ammesse dal backend: solo i domini reali di produzione.
CORS_ORIGINS=https://melpis.it,https://app.melpis.it
# Frontend dashboard (link nelle notifiche, billing return, ecc.)
FRONTEND_URL=https://app.melpis.it


# --- Proxy fidato -------------------------------------------------------------
# Solo la subnet Docker di Caddy; non usare reti private generiche.
TRUSTED_PROXY_CIDRS=172.30.0.0/24


# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Backend del rate limiter: redis (obbligatorio con piu' worker/replica).
RATE_LIMIT_BACKEND=redis
# Redis/Valkey condiviso tra i worker (rete Docker interna).
REDIS_URL=redis://valkey:6379/0


# --- Documentazione API protetta ---------------------------------------------
# Basic auth per /docs in produzione: compilare SOLO se si vuole esporre la
# documentazione; lasciare vuoto per mantenerla disattivata.
DOCS_BASIC_AUTH_USER=
DOCS_BASIC_AUTH_PASSWORD=
DOCS_ALLOWED_CIDRS=


# --- Stripe (billing) ---------------------------------------------------------
# Il profilo commercial_bootstrap richiede credenziali Stripe Live coerenti.
# I placeholder seguenti bloccano intenzionalmente preflight e startup.
STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_PUBLISHABLE_KEY=pk_live_replace-me
# Segreto del webhook endpoint di produzione (dashboard Stripe -> Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# Price ID mensili (dashboard Stripe -> Products -> Pricing).
STRIPE_PRICE_STARTER=price_starter_monthly_xxx
STRIPE_PRICE_PRO=price_pro_monthly_xxx
STRIPE_PRICE_BUSINESS=price_business_monthly_xxx
# L'annuale (€288/€708/€1.548) resta disabilitato finché l'offerta non è approvata.
STRIPE_ANNUAL_PRICING_ENABLED=false
# Compilare i Price ID solo dopo approvazione e impostare il flag a true.
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=
# Giorni di trial gratuito per i nuovi abbonamenti.
STRIPE_TRIAL_DAYS=7
# URL di ritorno dopo checkout/portale fatturazione Stripe.
STRIPE_RETURN_URL=https://app.melpis.it/


# --- Google Calendar Sync -----------------------------------------------------
# Integrazione disabilitata al lancio; una futura attivazione richiede un gate
# dedicato e credenziali verificate.
GOOGLE_CALENDAR_ENABLED=false
# Crea un progetto in Google Cloud Console → abilita Calendar API → ottieni
# client ID e secret (OAuth 2.0 -> Web application).
# ⚠️ L'app DEVE essere in stato "Published" OPPURE l'email del titolare
# aggiunta come Test User, altrimenti refresh_token NON viene rilasciato
# e il sync muore dopo 1 ora.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://melpis.it/api/calendar/oauth2callback
# Google Business Profile: stesso client OAuth, scope business.manage.
# Abilita "Business Profile API" (ex "My Business API") nel progetto GCP.
GOOGLE_BUSINESS_ENABLED=false
GOOGLE_REVIEWS_REDIRECT_URI=https://melpis.it/api/reviews/google/oauth2callback


# --- Osservabilità ------------------------------------------------------------
# DSN Sentry (sentry.io o self-hosted). Se vuoto Sentry non viene inizializzato:
# nessuna telemetria inviata.
SENTRY_DSN=


# --- Verifica database / backup ----------------------------------------------
# Database dedicato alle verifiche post-deploy (lasciare vuoto se uguale al principale).
VERIFY_DATABASE_URL=
# Directory dei backup logici e frequenza del drill di ripristino (secondi;
# 2592000 = 30 giorni). Il drill all'avvio resta disattivato di default.
BACKUP_DIR=backups
BACKUP_DRILL_INTERVAL_SECONDS=2592000
BACKUP_DRILL_RUN_ON_START=false


# --- GDPR hard-delete propagation ---------------------------------------------
# Chiave e webhook Softfr per propagare l'hard-delete GDPR ai sistemi esterni.
SOFTR_API_KEY=
SOFTR_WEBHOOK_URL=


# --- Email (HITL) -------------------------------------------------------------
# Notifiche per escalation, sospensioni e avvisi al gestore.
# Se SMTP_HOST/SMTP_USER/SMTP_PASSWORD/SMTP_FROM sono vuoti le notifiche
# vengono saltate con un warning (niente crash all'avvio).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
