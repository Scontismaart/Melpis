---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RestaurantHeader from '../../components/RestaurantHeader.astro';
import RestaurantApprovalStack from '../../components/RestaurantApprovalStack';
import RestaurantKnowledgeShowcase from '../../components/RestaurantKnowledgeShowcase';
import SaloniScenariosShowcase from '../../components/SaloniScenariosShowcase';
import RestaurantReviewsShowcase from '../../components/RestaurantReviewsShowcase';
import RestaurantFaqAccordion from '../../components/RestaurantFaqAccordion';
import PricingSection from '../../components/PricingSection.astro';
import FinalCta from '../../components/FinalCta.astro';
import Footer from '../../components/Footer.astro';
import MelpisFlowDemoConsole from '../../components/MelpisFlowDemoConsole.jsx';
import '../../styles/mv2-restaurants.css';

const base = import.meta.env.BASE_URL;
const title = "Melpis per Centri Estetici — Più tempo per i trattamenti";
const description = "Dedica più tempo ai trattamenti. Meno tempo alle richieste. Risposte istantanee su servizi, durate e gestione appuntamenti per il tuo centro estetico.";
const canonicalPath = `${base}saloni/`;

const saloniFaqs = [
  {
    q: "Come fa Melpis a presentare i trattamenti e i protocolli del centro?",
    a: "Puoi caricare le schede dei trattamenti con descrizioni, durate stimate e prezzi, oltre alle indicazioni pre-trattamento (es. preparazioni specifiche o tempi di posa). Melpis risponde con precisione usando solo le informazioni che hai approvato."
  },
  {
    q: "Come vengono gestiti i trattamenti combinati o di lunga durata?",
    a: "Puoi impostare regole per i trattamenti che richiedono più tempo (es. pacchetti viso + massaggio oltre 90 minuti). Oltre tale soglia, Melpis raccoglie le preferenze della cliente e passa la conferma all'operatrice o alla responsabile."
  },
  {
    q: "Posso intervenire personalmente nelle chat con le clienti abituali?",
    a: "Certamente. Dalla dashboard vedi tutte le conversazioni in tempo reale. Con un solo clic puoi prendere in carico la chat per salutare una cliente affezionata o dare un consiglio personalizzato."
  },
  {
    q: "Posso mantenere il numero WhatsApp del centro estetico?",
    a: "Sì, l'integrazione avviene tramite WhatsApp Business API ufficiale sul numero del centro. Le clienti non devono installare app esterne né cambiare numero di contatto."
  },
  {
    q: "Ci sono commissioni sulle prenotazioni o sui trattamenti eseguiti?",
    a: "No, zero commissioni sui trattamenti. Il centro mantiene il 100% dei ricavi dai propri clienti; il costo è limitato all'abbonamento mensile a tariffa fissa."
  }
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} pageClass="mv2-restaurants-page">
  <RestaurantHeader scenarioLabel="Trattamenti & agenda" navAriaLabel="Navigazione Centri Estetici" />

  <main id="mv2-contenuto" class="mv2-restaurants mv2-sector--saloni">
    {/* ======================================================================
        B. HERO SECTION
        ====================================================================== */}
    <section class="mv2-rest-hero" id="mv2-rest-hero" aria-labelledby="mv2-rest-hero-title">
      <div class="mv2-rest-container">
        <div class="mv2-rest-eyebrow-pill">
          <span>Centri estetici</span>
        </div>

        <h1 class="mv2-rest-hero-title" id="mv2-rest-hero-title">
          Dedica più tempo ai trattamenti.<br />
          <span class="mv2-rest-highlight">Meno tempo</span> alle richieste.
        </h1>

        <p class="mv2-rest-hero-desc">
          Melpis risponde alle domande sui servizi, consulta listini e orari e aiuta a gestire le richieste di appuntamento secondo le regole del tuo centro estetico.
        </p>

        <div class="mv2-rest-hero-actions">
          <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
            <span>Prova Melpis gratis</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="mv2-rest-btn-secondary" href="#mv2-rest-demo">
            <span>Scopri come funziona in salone</span>
          </a>
        </div>

        {/* Hero Demo Container */}
        <div class="mv2-rest-hero-mock-wrap" id="mv2-rest-demo">
          <div class="mv2-flow-stage" data-mv2-reveal="stage">
            <div class="mv2-flow-aurora" aria-hidden="true" data-mv2-aurora-pause="true" data-inview="true">
              <span class="mv2-flow-aurora-layer mv2-flow-aurora-layer-a"></span>
              <span class="mv2-flow-aurora-layer mv2-flow-aurora-layer-b"></span>
              <span class="mv2-flow-aurora-drift"></span>
            </div>
            <MelpisFlowDemoConsole client:load variant="saloni" />
          </div>
        </div>
      </div>
    </section>

    {/* ======================================================================
        D & E. SCENARI DIMOSTRATIVI SCROLL-DRIVEN
        ====================================================================== */}
    <section class="mv2-rest-scenari-section" id="mv2-rest-scenari" aria-labelledby="mv2-rest-scenari-title">
      <div class="mv2-rest-container">
        <SaloniScenariosShowcase client:load>
          <div class="mv2-rest-editorial-header">
            <h2 class="mv2-rest-editorial-title mv2-rest-sr-only" id="mv2-rest-scenari-title">
              Più tempo per le clienti.<br />
              <span class="mv2-rest-highlight">Meno tempo alla cassa.</span>
            </h2>

            <p class="mv2-rest-editorial-desc">
              Trattamenti viso, manicure, pedicure e disponibilità in cabina: Melpis risponde con precisione a ogni richiesta e lascia alle operatrici il controllo completo.
            </p>
          </div>
        </SaloniScenariosShowcase>
      </div>
    </section>

    {/* ======================================================================
        F. SEZIONI FUNZIONALI ALTERNATE (3 Blocks)
        ====================================================================== */}
    <section class="mv2-rest-features-wrapper" id="mv2-rest-funzioni" aria-label="Funzionalità dettagliate per centri estetici">
      {/* Block 01 */}
      <div class="mv2-rest-feature-block">
        <div class="mv2-rest-container">
          <div class="mv2-rest-feature-grid">
            <div class="mv2-rest-feature-text-col">
              <h2 class="mv2-rest-feature-title">
                Tutti i trattamenti del centro spiegati con cura,<br />
                <span class="mv2-rest-highlight">senza interrompere le sedute in cabina.</span>
              </h2>
              <p class="mv2-rest-feature-desc">
                Trattamenti viso, manicure semipermanente, pedicure, epilazione laser, durate e prezzi: l'AI risponde alle clienti solo con le informazioni verificate del tuo centro. Meno tempo passato a digitare messaggi, più valore a ogni momento di cura.
              </p>

              <ul class="mv2-rest-checklist">
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Conosce protocolli, durate delle sedute e indicazioni pre e post trattamento</span>
                </li>
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Risponde con chiarezza e puntualità su WhatsApp e Instagram 24 ore su 24</span>
                </li>
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Tono elegante, rassicurante e professionale, in sintonia con l'esperienza del tuo centro</span>
                </li>
              </ul>

              <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
                <span>Prova Melpis gratis</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mv2-rest-feature-mock-col">
              <RestaurantKnowledgeShowcase client:load variant="saloni" />
            </div>
          </div>
        </div>
      </div>

      {/* Block 03 */}
      <div class="mv2-rest-feature-block">
        <div class="mv2-rest-container">
          <div class="mv2-rest-feature-grid">
            <div class="mv2-rest-feature-text-col">
              <h2 class="mv2-rest-feature-title">
                L'assistente accoglie.<br />
                Il centro estetico decide.
              </h2>
              <p class="mv2-rest-feature-desc">
                Le risposte seguono fedelmente le tue regole di cabina e i tempi di posa. Quando una richiesta riguarda trattamenti combinati o valutazioni personalizzate, ricevi una notifica e puoi intervenire con un clic.
              </p>

              <div class="mv2-rest-boxes-row">
                <div class="mv2-rest-info-box">
                  <h4 class="mv2-rest-info-box-title">Soglia cabina</h4>
                  <p class="mv2-rest-info-box-desc">Conferma manuale per trattamenti combinati oltre 90 minuti.</p>
                </div>
                <div class="mv2-rest-info-box">
                  <h4 class="mv2-rest-info-box-title">Presa in carico</h4>
                  <p class="mv2-rest-info-box-desc">Entra in chat con le clienti abituali con un solo clic.</p>
                </div>
              </div>

              <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
                <span>Prova Melpis gratis</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mv2-rest-feature-mock-col">
              <RestaurantApprovalStack client:load variant="saloni" />
            </div>
          </div>
        </div>
      </div>

      {/* Block 04 */}
      <div class="mv2-rest-feature-block">
        <div class="mv2-rest-container mv2-rest-container--reviews">
          <div class="mv2-rest-feature-grid mv2-rest-feature-grid--reverse mv2-rest-feature-grid--reviews">
            <div class="mv2-rest-feature-text-col">
              <h2 class="mv2-rest-feature-title">
                Fai brillare la reputazione del tuo centro<br />
                <span class="mv2-rest-highlight">su Google.</span>
              </h2>
              <p class="mv2-rest-feature-desc">
                Centralizza la gestione delle recensioni e valorizza la reputazione del tuo centro estetico. Melpis ti aiuta a predisporre risposte dedicate e calorose ai feedback delle clienti e a mantenere un profilo impeccabile.
              </p>

              <ul class="mv2-rest-checklist">
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Anteprima della gestione delle recensioni Google con bozze AI personalizzate</span>
                </li>
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Revisione e approvazione delle risposte da parte della responsabile prima dell'invio</span>
                </li>
              </ul>

              <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
                <span>Prova Melpis gratis</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mv2-rest-feature-mock-col">
              <RestaurantReviewsShowcase client:load variant="saloni" />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ======================================================================
        I. PIANI (White Section)
        ====================================================================== */}
    <PricingSection
      id="mv2-rest-piani"
      ctaHref="/registrati/"
      showEyebrow={false}
      showLead={false}
      showFootnote={false}
    />

    {/* ======================================================================
        J. FAQ (White Section)
        ====================================================================== */}
    <section class="mv2-rest-faq-section" id="mv2-rest-faq" aria-labelledby="mv2-rest-faq-title">
      <div class="mv2-rest-container">
        <div class="mv2-rest-faq-grid">
          <div>
            <h2 class="mv2-rest-editorial-title" id="mv2-rest-faq-title">
              Prima di attivare<br />
              Melpis nel centro.
            </h2>
            <p class="mv2-rest-editorial-desc mv2-rest-faq-description">
              Le risposte alle domande più comuni delle titolari di centri estetici su listini,
              durate delle sedute, gestione cabine e canali WhatsApp.
            </p>
          </div>

          <div>
            <RestaurantFaqAccordion client:load items={saloniFaqs} ariaLabel="Domande frequenti per centri estetici" />
          </div>
        </div>
      </div>
    </section>

    {/* ======================================================================
        K. FINAL CTA
        ====================================================================== */}
    <FinalCta id="mv2-rest-cta" ctaHref="/registrati/" />
  </main>

  <Footer isSubpage={true} currentPath={canonicalPath} />
</BaseLayout>
