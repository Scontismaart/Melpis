---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RestaurantHeader from '../../components/RestaurantHeader.astro';
import RestaurantApprovalStack from '../../components/RestaurantApprovalStack';
import RestaurantKnowledgeShowcase from '../../components/RestaurantKnowledgeShowcase';
import RestaurantScenariosShowcase from '../../components/RestaurantScenariosShowcase';
import RestaurantReviewsShowcase from '../../components/RestaurantReviewsShowcase';
import RestaurantFaqAccordion from '../../components/RestaurantFaqAccordion';
import PricingSection from '../../components/PricingSection.astro';
import FinalCta from '../../components/FinalCta.astro';
import Footer from '../../components/Footer.astro';
import MelpisFlowDemoConsole from '../../components/MelpisFlowDemoConsole.jsx';
import '../../styles/mv2-restaurants.css';

const base = import.meta.env.BASE_URL;
const title = "Melpis per Ristoranti — L'intelligenza artificiale per i tuoi tavoli";
const description = "Risposte istantanee su WhatsApp, gestione delle disponibilità per la tua sala, menu e allergeni. Meno tempo al telefono, più attenzione ai tuoi ospiti.";
const canonicalPath = `${base}ristoranti/`;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} pageClass="mv2-restaurants-page">
  <RestaurantHeader />

  <main id="mv2-contenuto" class="mv2-restaurants">
    {/* ======================================================================
        B. HERO SECTION
        ====================================================================== */}
    <section class="mv2-rest-hero" id="mv2-rest-hero" aria-labelledby="mv2-rest-hero-title">
      <div class="mv2-rest-container">
        <div class="mv2-rest-eyebrow-pill">
          <span>Ristoranti</span>
        </div>

        <h1 class="mv2-rest-hero-title" id="mv2-rest-hero-title">
          L'intelligenza artificiale che<br />
          <span class="mv2-rest-highlight">gestisce i tuoi tavoli</span> anche<br />
          durante il pieno servizio.
        </h1>

        <p class="mv2-rest-hero-desc">
          Risposte istantanee su WhatsApp, gestione delle disponibilità per la tua sala,
          risposte su menu e allergeni. Meno tempo al telefono tra i tavoli,
          più attenzione ai tuoi ospiti.
        </p>

        <div class="mv2-rest-hero-actions">
          <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
            <span>Prova Melpis gratis</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="mv2-rest-btn-secondary" href="#mv2-rest-demo">
            <span>Scopri come funziona in sala</span>
          </a>
        </div>

        {/* Hero Demo Container */}
        <div class="mv2-rest-hero-mock-wrap" id="mv2-rest-demo">
          <div class="mv2-flow-stage" data-mv2-reveal="stage">
            <div class="mv2-flow-aurora" aria-hidden="true" data-mv2-aurora-pause="true" data-inview="true">
              <span class="mv2-flow-aurora-layer mv2-flow-aurora-layer-a"></span>
              <span class="mv2-flow-aurora-layer mv2-flow-aurora-layer-b"></span>
              <span class="mv2-flow-aurora-drift"></span>
            </div>
            <MelpisFlowDemoConsole client:load />
          </div>
        </div>
      </div>
    </section>

    {/* ======================================================================
        D & E. CONFIGURAZIONE E GESTIONE DEL SERVIZIO & SCENARI
        ====================================================================== */}
    <section class="mv2-rest-scenari-section" id="mv2-rest-scenari" aria-labelledby="mv2-rest-scenari-title">
      <div class="mv2-rest-container">
        <RestaurantScenariosShowcase client:load>
          <div class="mv2-rest-editorial-header">
            <h2 class="mv2-rest-editorial-title mv2-rest-sr-only" id="mv2-rest-scenari-title">
              Configura una volta.<br />
              <span class="mv2-rest-highlight">Melpis gestisce il servizio.</span>
            </h2>

            <p class="mv2-rest-editorial-desc">
              I clienti vogliono risposte rapide su tavoli liberi, intolleranze, menu degustazione e orari della cucina.
              Melpis risponde subito e passa la parola allo staff solo quando serve.
            </p>
          </div>
        </RestaurantScenariosShowcase>
      </div>
    </section>

    {/* ======================================================================
        F. SEZIONI FUNZIONALI ALTERNATE (4 Blocks)
        ====================================================================== */}
    <section class="mv2-rest-features-wrapper" id="mv2-rest-funzioni" aria-label="Funzionalità dettagliate per ristoranti">
      {/* Block 01 */}
      <div class="mv2-rest-feature-block">
        <div class="mv2-rest-container">
          <div class="mv2-rest-feature-grid">
            <div class="mv2-rest-feature-text-col">
              <h2 class="mv2-rest-feature-title">
                Smetti di rispondere alle stesse domande<br />
                <span class="mv2-rest-highlight">alle 20:30 del sabato.</span>
              </h2>
              <p class="mv2-rest-feature-desc">
                Orari della cucina, opzioni per celiaci o intolleranti al lattosio, disponibilità in veranda,
                prezzi del menu degustazione: l'AI gestisce tutto al posto del telefono.
                Meno interruzioni alla cassa, più tempo per gli ospiti seduti al tavolo.
              </p>

              <ul class="mv2-rest-checklist">
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Conosce alla perfezione il tuo menu, la carta dei vini e gli allergeni</span>
                </li>
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Risponde in italiano, inglese, tedesco, francese e spagnolo per i turisti</span>
                </li>
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Tono di voce configurabile: dall'osteria verace al fine dining stellato</span>
                </li>
              </ul>

              <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
                <span>Prova Melpis gratis</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mv2-rest-feature-mock-col">
              <RestaurantKnowledgeShowcase client:load />
            </div>
          </div>
        </div>
      </div>

      {/* Block 03 */}
      <div class="mv2-rest-feature-block">
        <div class="mv2-rest-container">
          <div class="mv2-rest-feature-grid">
            <div class="mv2-rest-feature-text-col">
              <h2 class="mv2-rest-feature-title">
                L'assistente aiuta.<br />
                Il ristorante decide.
              </h2>
              <p class="mv2-rest-feature-desc">
                Le richieste partono dalle tue informazioni e dalle regole della tua sala. Quando una richiesta supera il numero massimo di coperti o richiede l'approvazione del direttore di sala, il tuo team riceve una notifica e può approvare o prendere in carico la chat con un clic.
              </p>

              <div class="mv2-rest-boxes-row">
                <div class="mv2-rest-info-box">
                  <h4 class="mv2-rest-info-box-title">Soglia coperti</h4>
                  <p class="mv2-rest-info-box-desc">Richiedi approvazione manuale es. oltre 8 persone.</p>
                </div>
                <div class="mv2-rest-info-box">
                  <h4 class="mv2-rest-info-box-title">Presa in carico</h4>
                  <p class="mv2-rest-info-box-desc">Un operatore entra in conversazione quando vuole.</p>
                </div>
              </div>

              <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
                <span>Prova Melpis gratis</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mv2-rest-feature-mock-col">
              <RestaurantApprovalStack client:load />
            </div>
          </div>
        </div>
      </div>

      {/* Block 04 */}
      <div class="mv2-rest-feature-block">
        <div class="mv2-rest-container mv2-rest-container--reviews">
          <div class="mv2-rest-feature-grid mv2-rest-feature-grid--reverse mv2-rest-feature-grid--reviews">
            <div class="mv2-rest-feature-text-col">
              <h2 class="mv2-rest-feature-title">
                Organizza i tavoli e<br />
                <span class="mv2-rest-highlight">segui le richieste.</span>
              </h2>
              <p class="mv2-rest-feature-desc">
                Scopri la demo delle bozze AI per recensioni. L’integrazione con Google è ancora da verificare.
                Melpis ti aiuta a predisporre risposte coerenti ai feedback dei clienti e a mantenere
                il profilo della tua attività curato e professionale.
              </p>

              <ul class="mv2-rest-checklist">
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Demo delle bozze AI per recensioni Google · integrazione da verificare</span>
                </li>
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Revisione e approvazione delle risposte da parte del tuo staff prima dell'invio</span>
                </li>
              </ul>

              <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
                <span>Prova Melpis gratis</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mv2-rest-feature-mock-col">
              <RestaurantReviewsShowcase client:load />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ======================================================================
        I. PIANI (White Section)
        ====================================================================== */}
    <PricingSection
      id="mv2-rest-piani"
      ctaHref="/registrati/"
      showEyebrow={false}
      showLead={false}
      showFootnote={false}
    />

    {/* ======================================================================
        J. FAQ (White Section)
        ====================================================================== */}
    <section class="mv2-rest-faq-section" id="mv2-rest-faq" aria-labelledby="mv2-rest-faq-title">
      <div class="mv2-rest-container">
        <div class="mv2-rest-faq-grid">
          <div>
            <h2 class="mv2-rest-editorial-title" id="mv2-rest-faq-title">
              Prima di attivare<br />
              Melpis in sala.
            </h2>
            <p class="mv2-rest-editorial-desc mv2-rest-faq-description">
              Le risposte alle domande più comuni dei ristoratori su turni, menu che cambiano,
              allergeni e numeri WhatsApp esistenti.
            </p>
          </div>

          <div>
            <RestaurantFaqAccordion client:load />
          </div>
        </div>
      </div>
    </section>

    {/* ======================================================================
        K. FINAL CTA
        ====================================================================== */}
    <FinalCta id="mv2-rest-cta" ctaHref="/registrati/" />
  </main>

  <Footer isSubpage={true} currentPath={canonicalPath} />
</BaseLayout>
