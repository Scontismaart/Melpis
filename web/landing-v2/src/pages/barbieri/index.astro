---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RestaurantHeader from '../../components/RestaurantHeader.astro';
import RestaurantApprovalStack from '../../components/RestaurantApprovalStack';
import RestaurantKnowledgeShowcase from '../../components/RestaurantKnowledgeShowcase';
import BarbieriScenariosShowcase from '../../components/BarbieriScenariosShowcase';
import RestaurantReviewsShowcase from '../../components/RestaurantReviewsShowcase';
import RestaurantFaqAccordion from '../../components/RestaurantFaqAccordion';
import PricingSection from '../../components/PricingSection.astro';
import FinalCta from '../../components/FinalCta.astro';
import Footer from '../../components/Footer.astro';
import MelpisFlowDemoConsole from '../../components/MelpisFlowDemoConsole.jsx';
import '../../styles/mv2-restaurants.css';

const base = import.meta.env.BASE_URL;
const title = "Melpis per Barbieri — Meno messaggi, più tagli in poltrona";
const description = "Tu pensa ai clienti sulla poltrona. Melpis pensa ai messaggi. Risposte automatiche su orari, prezzi e gestione appuntamenti per il tuo barber shop.";
const canonicalPath = `${base}barbieri/`;

const barbieriFaqs = [
  {
    q: "Come fa Melpis a conoscere il nostro listino prezzi e la durata dei tagli?",
    a: "Basta caricare il listino servizi con i prezzi e le durate medie stimate per ciascun trattamento (es. taglio 30 min, combo taglio e barba 45 min). Melpis utilizza questi dati per informare i clienti e verificare la disponibilità."
  },
  {
    q: "Come vengono gestite le richieste di appuntamento in orari già occupati?",
    a: "Se l'orario richiesto dal cliente non è disponibile, Melpis propone automaticamente gli slot liberi più vicini (es. 30 minuti prima o dopo), evitando che il cliente rinunci e riducendo il tempo perso in scambi di messaggi."
  },
  {
    q: "Posso usare il numero WhatsApp che i clienti conoscono già?",
    a: "Sì, puoi mantenere il numero WhatsApp Business già attivo per il tuo salone. I clienti continueranno a scrivere allo stesso numero di sempre, ricevendo risposte immediate anche mentre hai le forbici in mano."
  },
  {
    q: "Cosa succede se un cliente vuole spostare o cancellare un appuntamento?",
    a: "Melpis raccoglie la richiesta di modifica, verifica gli orari alternativi e, se la modifica richiede conferma del barbiere, notifica il salone permettendoti di intervenire manualmente con un clic."
  },
  {
    q: "Melpis applica costi o commissioni su ciascun appuntamento?",
    a: "Nessuna commissione per appuntamento. Paghi solo il canone fisso mensile del piano scelto, senza costi nascosti o percentuali sui servizi erogati."
  }
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} pageClass="mv2-restaurants-page">
  <RestaurantHeader scenarioLabel="Gestione poltrone" navAriaLabel="Navigazione Barbieri" />

  <main id="mv2-contenuto" class="mv2-restaurants mv2-sector--barbieri">
    {/* ======================================================================
        B. HERO SECTION
        ====================================================================== */}
    <section class="mv2-rest-hero" id="mv2-rest-hero" aria-labelledby="mv2-rest-hero-title">
      <div class="mv2-rest-container">
        <div class="mv2-rest-eyebrow-pill">
          <span>Barbieri</span>
        </div>

        <h1 class="mv2-rest-hero-title" id="mv2-rest-hero-title">
          Tu pensa ai clienti sulla poltrona.<br />
          <span class="mv2-rest-highlight">Melpis pensa</span> ai messaggi.
        </h1>

        <p class="mv2-rest-hero-desc">
          Melpis risponde alle richieste sui servizi, informa i clienti su prezzi e orari e aiuta a organizzare gli appuntamenti seguendo le regole del tuo barber shop.
        </p>

        <div class="mv2-rest-hero-actions">
          <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
            <span>Prova Melpis gratis</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="mv2-rest-btn-secondary" href="#mv2-rest-demo">
            <span>Scopri come funziona in poltrona</span>
          </a>
        </div>

        {/* Hero Demo Container */}
        <div class="mv2-rest-hero-mock-wrap" id="mv2-rest-demo">
          <div class="mv2-flow-stage" data-mv2-reveal="stage">
            <div class="mv2-flow-aurora" aria-hidden="true" data-mv2-aurora-pause="true" data-inview="true">
              <span class="mv2-flow-aurora-layer mv2-flow-aurora-layer-a"></span>
              <span class="mv2-flow-aurora-layer mv2-flow-aurora-layer-b"></span>
              <span class="mv2-flow-aurora-drift"></span>
            </div>
            <MelpisFlowDemoConsole client:load variant="barbieri" />
          </div>
        </div>
      </div>
    </section>

    {/* ======================================================================
        D & E. SCENARI DIMOSTRATIVI SCROLL-DRIVEN
        ====================================================================== */}
    <section class="mv2-rest-scenari-section" id="mv2-rest-scenari" aria-labelledby="mv2-rest-scenari-title">
      <div class="mv2-rest-container">
        <BarbieriScenariosShowcase client:load>
          <div class="mv2-rest-editorial-header">
            <h2 class="mv2-rest-editorial-title mv2-rest-sr-only" id="mv2-rest-scenari-title">
              Tu pensa al taglio.<br />
              <span class="mv2-rest-highlight">Melpis pensa ai messaggi.</span>
            </h2>

            <p class="mv2-rest-editorial-desc">
              Prezzi, orari, appuntamenti e disponibilità poltrona: Melpis gestisce le richieste su WhatsApp mentre sei impegnato a lavorare.
            </p>
          </div>
        </BarbieriScenariosShowcase>
      </div>
    </section>

    {/* ======================================================================
        F. SEZIONI FUNZIONALI ALTERNATE (3 Blocks)
        ====================================================================== */}
    <section class="mv2-rest-features-wrapper" id="mv2-rest-funzioni" aria-label="Funzionalità dettagliate per barber shop">
      {/* Block 01 */}
      <div class="mv2-rest-feature-block">
        <div class="mv2-rest-container">
          <div class="mv2-rest-feature-grid">
            <div class="mv2-rest-feature-text-col">
              <h2 class="mv2-rest-feature-title">
                Smetti di interrompere il taglio<br />
                <span class="mv2-rest-highlight">per rispondere al telefono.</span>
              </h2>
              <p class="mv2-rest-feature-desc">
                Prezzi del listino, combo taglio e barba, orari di apertura del salone, indirizzo e tempi di attesa: l'AI risponde subito al posto tuo. Meno interruzioni con le forbici in mano, più concentrazione su ogni cliente.
              </p>

              <ul class="mv2-rest-checklist">
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Conosce alla perfezione il listino servizi, durate stimate e prodotti styling</span>
                </li>
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Risponde 24 ore su 24 su WhatsApp senza farti perdere clienti</span>
                </li>
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Tono di voce professionale e diretto, configurato attorno al tuo barber shop</span>
                </li>
              </ul>

              <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
                <span>Prova Melpis gratis</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mv2-rest-feature-mock-col">
              <RestaurantKnowledgeShowcase client:load variant="barbieri" />
            </div>
          </div>
        </div>
      </div>

      {/* Block 03 */}
      <div class="mv2-rest-feature-block">
        <div class="mv2-rest-container">
          <div class="mv2-rest-feature-grid">
            <div class="mv2-rest-feature-text-col">
              <h2 class="mv2-rest-feature-title">
                L'assistente organizza.<br />
                Il barbiere decide.
              </h2>
              <p class="mv2-rest-feature-desc">
                Le risposte seguono solo le tue regole e la disponibilità della tua agenda. Quando un cliente richiede un servizio speciale, un pacchetto sposo o una variazione di orario, ricevi una notifica e puoi intervenire con un clic.
              </p>

              <div class="mv2-rest-boxes-row">
                <div class="mv2-rest-info-box">
                  <h4 class="mv2-rest-info-box-title">Servizi speciali</h4>
                  <p class="mv2-rest-info-box-desc">Conferma manuale per servizi oltre 60 minuti o pacchetti sposo.</p>
                </div>
                <div class="mv2-rest-info-box">
                  <h4 class="mv2-rest-info-box-title">Presa in carico</h4>
                  <p class="mv2-rest-info-box-desc">Intervieni di persona nella chat con un clic dal tuo smartphone.</p>
                </div>
              </div>

              <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
                <span>Prova Melpis gratis</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mv2-rest-feature-mock-col">
              <RestaurantApprovalStack client:load variant="barbieri" />
            </div>
          </div>
        </div>
      </div>

      {/* Block 04 */}
      <div class="mv2-rest-feature-block">
        <div class="mv2-rest-container mv2-rest-container--reviews">
          <div class="mv2-rest-feature-grid mv2-rest-feature-grid--reverse mv2-rest-feature-grid--reviews">
            <div class="mv2-rest-feature-text-col">
              <h2 class="mv2-rest-feature-title">
                Recensioni sempre curate e<br />
                <span class="mv2-rest-highlight">poltrone sempre piene.</span>
              </h2>
              <p class="mv2-rest-feature-desc">
                Centralizza la gestione delle recensioni e valorizza la reputazione del tuo barber shop. Melpis ti aiuta a predisporre risposte coerenti e puntuali ai feedback dei clienti e a mantenere il profilo Google della tua attività sempre attivo.
              </p>

              <ul class="mv2-rest-checklist">
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Demo delle bozze AI per recensioni Google · integrazione da verificare</span>
                </li>
                <li>
                  <span class="mv2-rest-check-circle" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <polyline points="3 8.5 6.5 12 13 4"></polyline>
                    </svg>
                  </span>
                  <span>Revisione e approvazione delle risposte da parte del titolare prima dell'invio</span>
                </li>
              </ul>

              <a class="mv2-rest-btn-primary" href="#mv2-rest-piani">
                <span>Prova Melpis gratis</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mv2-rest-feature-mock-col">
              <RestaurantReviewsShowcase client:load variant="barbieri" />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ======================================================================
        I. PIANI (White Section)
        ====================================================================== */}
    <PricingSection
      id="mv2-rest-piani"
      ctaHref="/registrati/"
      showEyebrow={false}
      showLead={false}
      showFootnote={false}
    />

    {/* ======================================================================
        J. FAQ (White Section)
        ====================================================================== */}
    <section class="mv2-rest-faq-section" id="mv2-rest-faq" aria-labelledby="mv2-rest-faq-title">
      <div class="mv2-rest-container">
        <div class="mv2-rest-faq-grid">
          <div>
            <h2 class="mv2-rest-editorial-title" id="mv2-rest-faq-title">
              Prima di attivare<br />
              Melpis in salone.
            </h2>
            <p class="mv2-rest-editorial-desc mv2-rest-faq-description">
              Le risposte alle domande più comuni dei barbieri su gestione poltrone,
              listini, appuntamenti e numeri WhatsApp esistenti.
            </p>
          </div>

          <div>
            <RestaurantFaqAccordion client:load items={barbieriFaqs} ariaLabel="Domande frequenti per barbieri" />
          </div>
        </div>
      </div>
    </section>

    {/* ======================================================================
        K. FINAL CTA
        ====================================================================== */}
    <FinalCta id="mv2-rest-cta" ctaHref="/registrati/" />
  </main>

  <Footer isSubpage={true} currentPath={canonicalPath} />
</BaseLayout>
