---
import { plans, pageNotes } from '../data/pricing.mjs';

---

<section class="mv2-pp-plans" id="mv2-pp-piani" aria-labelledby="mv2-pp-piani-title">
  <div class="mv2-pp-container">
    <h2 class="mv2-pp-visually-hidden" id="mv2-pp-piani-title">Piani disponibili</h2>

    <div class="mv2-pp-plan-grid">
      {plans.map((plan) => (
        <article class="mv2-pp-plan" data-featured={String(plan.featured)}>
          <div class="mv2-pp-plan-head">
            <span class="mv2-pp-plan-icon" aria-hidden="true">
              {plan.icon === 'spark' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <path d="M12 3.5l1.9 4.8 4.8 1.9-4.8 1.9L12 16.9l-1.9-4.8L5.3 10.2l4.8-1.9z" />
                  <path d="M18.4 16.4l.7 1.7 1.7.7-1.7.7-.7 1.7-.7-1.7-1.7-.7 1.7-.7z" />
                </svg>
              )}
              {plan.icon === 'chat' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <path d="M20 14.5a2 2 0 0 1-2 2H8.4L4.5 20V6a2 2 0 0 1 2-2h11.5a2 2 0 0 1 2 2z" />
                  <path d="M8 8.5h8M8 12h5" />
                </svg>
              )}
              {plan.icon === 'team' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <circle cx="9" cy="8" r="3" />
                  <path d="M3.5 19.5a5.5 5.5 0 0 1 11 0" />
                  <path d="M15.5 5.4a3 3 0 0 1 0 5.2M17.5 14.6a5.5 5.5 0 0 1 3 4.9" />
                </svg>
              )}
              {plan.icon === 'layers' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <path d="M12 3.5l8.5 4.3-8.5 4.3-8.5-4.3z" />
                  <path d="M3.5 12.2l8.5 4.3 8.5-4.3" />
                  <path d="M3.5 16.4l8.5 4.3 8.5-4.3" />
                </svg>
              )}
            </span>
            <h3 class="mv2-pp-plan-name">{plan.name}</h3>
            {plan.badge && <span class="mv2-pp-plan-badge">{plan.badge}</span>}
          </div>

          <p class="mv2-pp-price">
            <span class="mv2-pp-price-amount">{plan.price}</span>
            <span class="mv2-pp-price-currency">{plan.currency}</span>
            <span class="mv2-pp-price-period">{plan.period}</span>
          </p>

          <p class="mv2-pp-price-note">{plan.priceNote}</p>

          <p class="mv2-pp-plan-sub">{plan.subtitle}</p>

          <a class="mv2-pp-plan-cta" href={plan.ctaPath} aria-label={plan.ctaAria}>
            {plan.ctaLabel}
          </a>

          <div class="mv2-pp-plan-rule" aria-hidden="true"></div>

          <p class="mv2-pp-plan-plus">{plan.plusHeading}</p>

          <ul class="mv2-pp-plan-features">
            {plan.features.map((feature) => (
              <li class="mv2-pp-plan-feature">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M2.5 7.4l3 3L11.5 4" />
                </svg>
                <span>
                  {feature.strong && <strong>{feature.strong} </strong>}
                  {feature.text}
                </span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <ul class="mv2-pp-notes" id="costi-meta">
      {pageNotes.map((note) => <li>{note}</li>)}
    </ul>
  </div>
</section>
