---
import MelpisFlowDemoConsole from './MelpisFlowDemoConsole.jsx';
---

<section class="mv2-sector-section-demo" id="mv2-barbieri-demo" aria-labelledby="mv2-barbieri-demo-title">
  <div class="mv2-sector-demo-header" data-sector-reveal>
    <div class="mv2-sector-demo-header__left">
      <div class="mv2-sector-demo-badge">
        <span>DEMO INTERATTIVA</span>
      </div>
      <h2 class="mv2-sector-demo-title" id="mv2-barbieri-demo-title">
        <span class="mv2-sector-demo-title__main">Dalla richiesta all'appuntamento confermato.</span>
        <span class="mv2-sector-demo-title__sub">Scopri come Melpis gestisce prenotazioni, poltrone e richieste per la tua barberia.</span>
      </h2>
    </div>

    <div class="mv2-sector-demo-header__right">
      <p>Il cliente scrive su WhatsApp, Melpis interpreta il taglio o trattamento barba, consulta l'agenda e assegna la poltrona prima di confermare.</p>
    </div>
  </div>

  <!-- Stage wrapper: Hero-like card block with ambient tobacco/amber glow & silk reflections -->
  <div class="mv2-sector-demo-stage mv2-sector-demo-stage--barbieri">
    <div class="mv2-sector-demo-aurora" aria-hidden="true">
      <span class="mv2-sector-demo-aurora-layer mv2-sector-demo-aurora-layer-a"></span>
      <span class="mv2-sector-demo-aurora-layer mv2-sector-demo-aurora-layer-b"></span>
      <span class="mv2-sector-demo-aurora-beam"></span>
      <svg class="mv2-sector-demo-aurora-waves" viewBox="0 0 1340 820" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="mv2-barbieri-stageWaveTop" x1="0" y1="0" x2="1340" y2="820" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.95" />
            <stop offset="35%" stop-color="#FAF6F2" stop-opacity="0.65" />
            <stop offset="68%" stop-color="#F2EBE3" stop-opacity="0.40" />
            <stop offset="100%" stop-color="#E8DDD2" stop-opacity="0.12" />
          </linearGradient>
          <linearGradient id="mv2-barbieri-stageWaveBottom" x1="180" y1="820" x2="1340" y2="520" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#FAF7F4" stop-opacity="0.55" />
            <stop offset="55%" stop-color="#F4ECE5" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.85" />
          </linearGradient>
          <filter id="mv2-barbieri-stageRidgeShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="-1" dy="4" stdDeviation="5" flood-color="#784A28" flood-opacity="0.10" />
          </filter>
        </defs>
        <path d="M 0 240 C 320 280, 700 180, 1020 120 C 1170 92, 1260 80, 1340 70 L 1340 0 L 0 0 Z" fill="url(#mv2-barbieri-stageWaveTop)" />
        <path d="M 0 240 C 320 280, 700 180, 1020 120 C 1170 92, 1260 80, 1340 70" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" filter="url(#mv2-barbieri-stageRidgeShadow)" />
        <path d="M 160 820 C 460 720, 820 750, 1340 650 L 1340 820 Z" fill="url(#mv2-barbieri-stageWaveBottom)" />
        <path d="M 160 820 C 460 720, 820 750, 1340 650" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" filter="url(#mv2-barbieri-stageRidgeShadow)" />
      </svg>
    </div>

    <!-- The Interactive Console Island -->
    <MelpisFlowDemoConsole client:idle variant="barbieri" />
  </div>
</section>
