<div class="mv2-pricing-curve curve-transition-stage" aria-hidden="true" data-mv2-pricing-curve>
  <div class="mv2-pricing-curve-motion curve-transition-motion" data-mv2-pricing-curve-motion>
    <svg
      class="mv2-pricing-curve-svg curve-transition-svg"
      viewBox="0 0 1440 215"
      fill="none"
      preserveAspectRatio="none"
    >
      <defs>
        <!-- Dark ground melts out of the real Setup section into the Argon #07080b.
             The first stops are translucent so the real Setup ground shows through the
             negative-margin overlap; the fade completes before the Setup edge, so no
             white page can bleed through as a horizontal band. -->
        <linearGradient id="mv2-pricing-dark-ground" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#050609" stop-opacity="0" />
          <stop offset="20%" stop-color="#050609" stop-opacity="0" />
          <stop offset="32%" stop-color="#07080b" stop-opacity="1" />
          <stop offset="100%" stop-color="#07080b" stop-opacity="1" />
        </linearGradient>

        <!-- Soft atmospheric silver bloom in the dark upper space just above the rim -->
        <radialGradient id="mv2-pricing-dark-sky-bloom-left" cx="27%" cy="48%" r="34%">
          <stop offset="0%" stop-color="#383d48" stop-opacity="0.42" />
          <stop offset="48%" stop-color="#191c23" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#07080b" stop-opacity="0" />
        </radialGradient>

        <radialGradient id="mv2-pricing-dark-sky-bloom-right" cx="64%" cy="56%" r="32%">
          <stop offset="0%" stop-color="#323742" stop-opacity="0.34" />
          <stop offset="52%" stop-color="#15181f" stop-opacity="0.14" />
          <stop offset="100%" stop-color="#07080b" stop-opacity="0" />
        </radialGradient>

        <!-- Subtle diagonal facet ray on the upper-left dark zone -->
        <linearGradient id="mv2-pricing-dark-left-ray" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.055" />
          <stop offset="65%" stop-color="#ffffff" stop-opacity="0.02" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>

        <!-- Secondary Left Surface: delicate pale pearl-silver with low contrast -->
        <linearGradient id="mv2-pricing-left-wing-surface" x1="0%" y1="10%" x2="90%" y2="64%">
          <stop offset="0%" stop-color="#dfe2e8" />
          <stop offset="36%" stop-color="#eaecf0" />
          <stop offset="72%" stop-color="#f1f2f5" />
          <stop offset="100%" stop-color="#f3f3f5" />
        </linearGradient>

        <!-- Soft overlap shading along the secondary left arch (fades completely before bottom) -->
        <linearGradient id="mv2-pricing-left-wing-crease" x1="0%" y1="0%" x2="70%" y2="100%">
          <stop offset="0%" stop-color="#8c929e" stop-opacity="0.13" />
          <stop offset="44%" stop-color="#a0a5b1" stop-opacity="0.065" />
          <stop offset="76%" stop-color="#f3f3f5" stop-opacity="0" />
          <stop offset="100%" stop-color="#f3f3f5" stop-opacity="0" />
        </linearGradient>

        <!-- Primary Pearl Surface: luminous pearl-white near the rim, merging into exact #f3f3f5 by 68% -->
        <linearGradient id="mv2-pricing-pearl-main-surface" x1="50%" y1="0%" x2="50%" y2="100%">
          <stop offset="0%" stop-color="#fafafb" />
          <stop offset="26%" stop-color="#f6f6f8" />
          <stop offset="68%" stop-color="#f3f3f5" />
          <stop offset="100%" stop-color="#f3f3f5" />
        </linearGradient>

        <!-- Whisper-soft diffused shadow beneath the curve (no dark band, max opacity 0.13) -->
        <linearGradient id="mv2-pricing-lip-drop-shadow" x1="8%" y1="0%" x2="94%" y2="0%">
          <stop offset="0%" stop-color="#8d939f" stop-opacity="0" />
          <stop offset="18%" stop-color="#828894" stop-opacity="0.05" />
          <stop offset="36%" stop-color="#7a808c" stop-opacity="0.11" />
          <stop offset="54%" stop-color="#7a808c" stop-opacity="0.13" />
          <stop offset="74%" stop-color="#828894" stop-opacity="0.09" />
          <stop offset="92%" stop-color="#8d939f" stop-opacity="0.03" />
          <stop offset="100%" stop-color="#8d939f" stop-opacity="0" />
        </linearGradient>

        <!-- LAYER 1: Soft Diffused Ambient Halo (brighter in the center, attenuated at edges) -->
        <linearGradient id="mv2-pricing-rim-ambient-halo" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#cfd7e4" stop-opacity="0.08" />
          <stop offset="14%" stop-color="#e3e9f3" stop-opacity="0.22" />
          <stop offset="26%" stop-color="#ffffff" stop-opacity="0.48" />
          <stop offset="40%" stop-color="#f4f7fc" stop-opacity="0.38" />
          <stop offset="52%" stop-color="#ffffff" stop-opacity="0.42" />
          <stop offset="68%" stop-color="#eef3fa" stop-opacity="0.34" />
          <stop offset="84%" stop-color="#dce2ed" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#cfd7e4" stop-opacity="0.12" />
        </linearGradient>

        <!-- LAYER 2: Primary Thin Silver-Pearl Continuous Line -->
        <linearGradient id="mv2-pricing-rim-main-line" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#cfd5e0" stop-opacity="0.65" />
          <stop offset="16%" stop-color="#eaeff7" stop-opacity="0.86" />
          <stop offset="28%" stop-color="#ffffff" stop-opacity="0.96" />
          <stop offset="46%" stop-color="#f6f8fc" stop-opacity="0.92" />
          <stop offset="66%" stop-color="#ffffff" stop-opacity="0.94" />
          <stop offset="84%" stop-color="#e4e9f2" stop-opacity="0.82" />
          <stop offset="100%" stop-color="#d2d8e3" stop-opacity="0.7" />
        </linearGradient>

        <!-- LAYER 3A: Specular Micro-Highlight Soft Bloom (concentrated at peak reflection points) -->
        <linearGradient id="mv2-pricing-rim-catchlight-bloom" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
          <stop offset="12%" stop-color="#ffffff" stop-opacity="0.08" />
          <stop offset="25%" stop-color="#ffffff" stop-opacity="0.78" />
          <stop offset="37%" stop-color="#f8faff" stop-opacity="0.52" />
          <stop offset="48%" stop-color="#ffffff" stop-opacity="0.64" />
          <stop offset="66%" stop-color="#ffffff" stop-opacity="0.58" />
          <stop offset="82%" stop-color="#ffffff" stop-opacity="0.06" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>

        <!-- LAYER 3B: Specular Micro-Highlight Crisp Core (intense pearl-white catch-light) -->
        <linearGradient id="mv2-pricing-rim-catchlight-core" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
          <stop offset="8%" stop-color="#ffffff" stop-opacity="0" />
          <stop offset="18%" stop-color="#ffffff" stop-opacity="0.55" />
          <stop offset="26%" stop-color="#ffffff" stop-opacity="0.98" />
          <stop offset="38%" stop-color="#ffffff" stop-opacity="0.76" />
          <stop offset="49%" stop-color="#ffffff" stop-opacity="0.88" />
          <stop offset="66%" stop-color="#ffffff" stop-opacity="0.84" />
          <stop offset="78%" stop-color="#ffffff" stop-opacity="0.25" />
          <stop offset="86%" stop-color="#ffffff" stop-opacity="0" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>

        <!-- Calibrated Static Blur Filters -->
        <filter id="mv2-pricing-bevel-soft-blur" x="-8%" y="-40%" width="116%" height="200%">
          <feGaussianBlur stdDeviation="16" />
        </filter>

        <filter id="mv2-pricing-rim-ambient-blur" x="-5%" y="-30%" width="110%" height="160%">
          <feGaussianBlur stdDeviation="4.2" />
        </filter>

        <filter id="mv2-pricing-rim-micro-bloom-blur" x="-3%" y="-20%" width="106%" height="140%">
          <feGaussianBlur stdDeviation="1.1" />
        </filter>
      </defs>

      <!-- 1. Dark upper background + atmospheric silver blooms above the curve -->
      <rect width="1440" height="215" fill="url(#mv2-pricing-dark-ground)" />
      <rect width="1440" height="215" fill="url(#mv2-pricing-dark-sky-bloom-left)" />
      <rect width="1440" height="215" fill="url(#mv2-pricing-dark-sky-bloom-right)" />

      <!-- Subtle diagonal facet line in the dark left zone -->
      <path d="M 0 2 C 115 36, 235 72, 355 108 L 0 58 Z" fill="url(#mv2-pricing-dark-left-ray)" />
      <path d="M 0 2 C 115 36, 235 72, 355 108" stroke="rgba(255, 255, 255, 0.05)" stroke-width="0.9" fill="none" />

      <!-- 2. Secondary Overlapping Pale Pearl-Silver Surface on Left -->
      <path
        d="M 0 58 C 210 66, 485 148, 770 148 C 1035 148, 1265 82, 1440 38 L 1440 215 L 0 215 Z"
        fill="url(#mv2-pricing-left-wing-surface)"
      />

      <!-- 3. Primary Pearl Surface emerging from bottom with secondary left arch -->
      <path
        d="M 0 184 C 85 118, 235 100, 435 121 C 555 135, 665 148, 770 148 C 1035 148, 1265 82, 1440 38 L 1440 215 L 0 215 Z"
        fill="url(#mv2-pricing-pearl-main-surface)"
      />

      <!-- Delicate overlap crease along the secondary left arch (fades before bottom) -->
      <path d="M 0 184 C 85 118, 235 100, 435 121 L 435 192 L 0 206 Z" fill="url(#mv2-pricing-left-wing-crease)" />

      <!-- Subtle satin inner highlight on the secondary left arch -->
      <path d="M 0 184 C 85 118, 235 100, 435 121" stroke="#fbfcfd" stroke-opacity="0.58" stroke-width="0.85" fill="none" />

      <!-- 4. Whisper-Soft Wide Satin Depth Under the Main Rim (No dark band) -->
      <path
        d="M 165 78 C 375 116, 555 148, 770 148 C 1035 148, 1265 82, 1440 38 L 1440 56 C 1255 104, 1025 170, 768 170 C 545 168, 365 124, 165 78 Z"
        fill="url(#mv2-pricing-lip-drop-shadow)"
        filter="url(#mv2-pricing-bevel-soft-blur)"
      />

      <!-- 5. 4-layer satin silver highlight along the curve border -->
      <!-- Layer 1: Soft Diffused Ambient Halo around the border -->
      <path
        d="M 0 58 C 210 66, 485 148, 770 148 C 1035 148, 1265 82, 1440 38"
        stroke="url(#mv2-pricing-rim-ambient-halo)"
        stroke-width="10"
        fill="none"
        filter="url(#mv2-pricing-rim-ambient-blur)"
      />

      <!-- Layer 2: Primary Thin Silver-Pearl Line along the entire curve -->
      <path
        d="M 0 58 C 210 66, 485 148, 770 148 C 1035 148, 1265 82, 1440 38"
        stroke="url(#mv2-pricing-rim-main-line)"
        stroke-width="1.35"
        fill="none"
      />

      <!-- Layer 3A: Specular Micro-Highlight Soft Bloom at peak reflection points -->
      <path
        d="M 0 58 C 210 66, 485 148, 770 148 C 1035 148, 1265 82, 1440 38"
        stroke="url(#mv2-pricing-rim-catchlight-bloom)"
        stroke-width="3.2"
        fill="none"
        filter="url(#mv2-pricing-rim-micro-bloom-blur)"
      />

      <!-- Layer 3B: Specular Micro-Highlight Crisp Core at peak reflection points -->
      <path
        d="M 0 58 C 210 66, 485 148, 770 148 C 1035 148, 1265 82, 1440 38"
        stroke="url(#mv2-pricing-rim-catchlight-core)"
        stroke-width="1.15"
        fill="none"
      />
    </svg>
  </div>
</div>
