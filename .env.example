LLM_COST_POLICY=free_only
GROQ_FREE_ACCOUNT_CONFIRMED=false
GROQ_ZDR_CONFIRMED=false
LAUNCH_PROFILE=sandbox
SANDBOX_ONLY=true
STRIPE_ANNUAL_PRICING_ENABLED=false
WHATSAPP_TEST_RECIPIENTS=
INSTAGRAM_TEST_RECIPIENTS=
# Numero massimo di chiamate concorrenti sul tier FREE Groq.
# Qualunque passaggio a un provider o piano AI a pagamento richiede una nuova
# autorizzazione manuale esplicita; nessun upgrade o fallback e' automatico.
LLM_MAX_CONCURRENT=3
# Routing LLM: tutti i modelli del profilo zero cost usano Groq.
OPENROUTER_MODEL_CHEAP=groq/llama-3.1-8b-instant
OPENROUTER_MODEL_PREMIUM=groq/openai/gpt-oss-20b
OPENROUTER_MODEL_FALLBACKS=groq/llama-3.1-8b-instant,groq/openai/gpt-oss-120b
# Chiave Groq (fallback chain, modello gratuito verificato: openai/gpt-oss-20b).
GROQ_API_KEY=
# Default di crea_llm() quando non si passa model/route_request.
OPENROUTER_MODEL=groq/openai/gpt-oss-20b
# Adapter AI opzionale: in assenza di questi valori si mantengono le env legacy
# OPENROUTER_MODEL*, GROQ_API_KEY e il routing Groq del profilo EUR 0.
# Nel profilo free_only sono ammessi Groq FREE oppure OpenRouter con un modello
# esplicito openrouter/<vendor>/<model>:free confermato dal catalogo live ZDR.
# Per OpenRouter impostare AI_PROVIDER, AI_MODEL e OPENROUTER_API_KEY, lasciare
# vuote le vecchie OPENROUTER_MODEL* Groq, e NON impostare AI_API_KEY/AI_BASE_URL.
# Non esiste fallback automatico verso modelli a pagamento.
AI_PROVIDER=
AI_MODEL=
OPENROUTER_API_KEY=
# Solo se servono modelli diversi per task: se AI_MODEL e' definito, questi
# sostituiscono il vecchio routing OPENROUTER_MODEL_* (nessun fallback implicito).
AI_MODEL_CHEAP=
AI_MODEL_PREMIUM=
AI_MODEL_INTENT=
AI_MODEL_FALLBACKS=
AI_API_KEY=
# Obbligatoria solo con AI_PROVIDER=openai_compatible; HTTPS per endpoint remoti.
AI_BASE_URL=
# Sotto questa soglia di budget residuo (0..1) il routing forza il tier economico.
LLM_LOW_BUDGET_RATIO=0.10
# Guardrails (task 12, src/core/guardrails/):
# - classificatore di intent: modello economico (default = OPENROUTER_MODEL_CHEAP),
#   LLM usato solo quando l'euristica keyword e' incerta; fail-open sull'euristica
OPENROUTER_MODEL_INTENT=
GUARDRAIL_INTENT_LLM_ENABLED=true
# timeout (secondi) oltre il quale il classificatore LLM lascia il posto all'euristica
GUARDRAIL_INTENT_TIMEOUT=2.5
# - validatore post-LLM: lunghezza massima risposta inviata al cliente (caratteri)
GUARDRAIL_MAX_REPLY_CHARS=800
# - cache FAQ semantica: interruttore, distanza cosine massima per il match,
#   scadenza delle voci in ore (invalidata anche a ogni upload documento)
GUARDRAIL_CACHE_ENABLED=true
GUARDRAIL_CACHE_THRESHOLD=0.08
GUARDRAIL_CACHE_TTL_HOURS=72
# - A/B test prompt: varianti attive separate da virgola (definite in
#   src/agents/prompts.py PROMPT_VARIANTS; assegnazione deterministica per org)
GUARDRAIL_AB_VARIANTS=control
MISTRAL_API_KEY=
ENCRYPTION_KEY=
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# WhatsApp Cloud API (Meta) — senza queste due il webhook /webhooks/whatsapp
# non viene montato all'avvio (l'app parte comunque, ma Meta non puo' raggiungerti)
META_APP_SECRET=
META_VERIFY_TOKEN=

DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
# Task18 BFF: chiave anon del progetto Supabase (il BFF la usa verso
# /auth/v1/token). NON e' un segreto server-side (è pubblica), ma senza di
# lei il login BFF non parte. Il service_role key NON va messa qui.
SUPABASE_ANON_KEY=
# Task18 BFF: cookie sessione con flag Secure + prefisso __Host- (true in
# produzione/HTTPS, false solo in dev su http://localhost).
AUTH_COOKIE_SECURE=true
# Login Google (OAuth PKCE server-side): URL pubblico dell'app, usato come
# base del redirect_to verso /api/auth/google/callback. Deve corrispondere
# al dominio reale (es. https://melpis.it). Guida: docs/SETUP-GOOGLE-AUTH.md
PUBLIC_APP_URL=https://tuodominio
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,https://tua-dashboard.softr.app
# Task18 Fase 4: dimensione massima del pool asyncpg (default 5). Aumentala
# con piu' worker/replica o carico alto; per picchi reali usare un pooler
# esterno (Supavisor/pgBouncer) invece di gonfiare il pool per processo.
DB_POOL_MAX_SIZE=5
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://valkey:6379/0
TRUSTED_PROXY_CIDRS=172.30.0.0/24
APP_ENV=production
DOCS_BASIC_AUTH_USER=
DOCS_BASIC_AUTH_PASSWORD=
DOCS_ALLOWED_CIDRS=
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PRICE_STARTER=price_starter_xxx
STRIPE_PRICE_PRO=price_pro_xxx
STRIPE_PRICE_BUSINESS=price_business_xxx
STRIPE_TRIAL_DAYS=7

# Google Calendar Sync
GOOGLE_CALENDAR_ENABLED=false
# Crea un progetto in Google Cloud Console → abilita Calendar API → ottieni
# client ID e secret (OAuth 2.0 -> Web application).
# ⚠️ L'app DEVE essere in stato "Published" OPPURE l'email del titolare
# aggiunta come Test User, altrimenti refresh_token NON viene rilasciato
# e il sync muore dopo 1 ora.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tuodominio/api/calendar/oauth2callback
# Google Business Profile: stesso client OAuth, scope business.manage.
# Abilita "Business Profile API" (ex "My Business API") nel progetto GCP.
GOOGLE_BUSINESS_ENABLED=false
GOOGLE_REVIEWS_REDIRECT_URI=https://tuodominio/api/reviews/google/oauth2callback
FRONTEND_URL=http://localhost:5173

SENTRY_DSN=
# Get your DSN at https://sentry.io (or self-hosted Sentry). If empty, Sentry is
# not initialized — no telemetry sent.
VERIFY_DATABASE_URL=
BACKUP_DIR=backups
BACKUP_DRILL_INTERVAL_SECONDS=2592000
BACKUP_DRILL_RUN_ON_START=false

# GDPR hard-delete propagation
SOFTR_API_KEY=
SOFTR_WEBHOOK_URL=

# Email (HITL) — notifiche per escalation, sospensioni e avvisi al gestore.
# Se SMTP_HOST/SMTP_USER/SMTP_PASSWORD/SMTP_FROM sono vuoti le notifiche
# vengono saltate con un warning (niente crash all'avvio).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
