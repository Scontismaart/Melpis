{
  "name": "melpis-web-checks",
  "private": true,
  "scripts": {
    "lint:web": "eslint web/*.js web/landing/app.js web/scripts/compose-dashboard.mjs",
    "test:web": "node --test tests/frontend/*.test.cjs",
    "build:dashboard": "node web/scripts/compose-dashboard.mjs --write",
    "check:dashboard": "node web/scripts/compose-dashboard.mjs --check",
    "test:i18n": "node scripts/verify-i18n.js",
    "build:i18n": "node scripts/externalize-fullcalendar-styles.js && node scripts/build-i18n.js",
    "check:fullcalendar-css": "node scripts/externalize-fullcalendar-styles.js --check",
    "audit:csp": "node scripts/audit-csp.js",
    "audit:assets": "node scripts/audit-assets.js",
    "audit:images": "node scripts/audit-images.js",
    "audit:links": "node scripts/audit-links.js",
    "audit:seo": "node scripts/audit-seo.js",
    "audit:hardcoded": "node scripts/audit-hardcoded.js"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0"
  }
}
